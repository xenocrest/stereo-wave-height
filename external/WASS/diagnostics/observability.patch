+void PovMesh::cluster_biggest_connected_component( const boost::filesystem::path workdir, const double zgap_percentile )
+{
     LOG_SCOPE("cluster");
     LOGI << "extracting connected-components";
     //cv::imwrite("meshcol.png",pImpl->get_RGB_image());
-    pImpl->set_all_visited( false );
+    // Read-only diagnostic enumeration. It deliberately uses separate state and
+    // the same four-neighbour, strict-Z-gap predicate as the production pass.
+    std::vector<int32_t> diagnostic_labels(pImpl->size(), -1);
+    std::vector<size_t> diagnostic_sizes;
+    int32_t diagnostic_component = 0;
+    int32_t diagnostic_retained = -1;
+    size_t diagnostic_retained_size = 0;
+    for( size_t u=0; u<static_cast<size_t>(width()); ++u )
+    {
+        for( size_t v=0; v<static_cast<size_t>(height()); ++v )
+        {
+            const size_t seed = v*static_cast<size_t>(width())+u;
+            if( !pImpl->PTc(seed).valid || diagnostic_labels[seed] >= 0 ) continue;
+            size_t component_size = 0;
+            std::vector<size_t> stack(1, seed);
+            diagnostic_labels[seed] = diagnostic_component;
+            while( !stack.empty() )
+            {
+                const size_t idx = stack.back(); stack.pop_back();
+                ++component_size;
+                const size_t cu = idx % static_cast<size_t>(width());
+                const size_t cv = idx / static_cast<size_t>(width());
+                const double z = pImpl->PTc(idx).p3d[2];
+                const int du[4] = {-1,1,0,0};
+                const int dv[4] = {0,0,-1,1};
+                for( int n=0; n<4; ++n )
+                {
+                    const int nu = static_cast<int>(cu)+du[n];
+                    const int nv = static_cast<int>(cv)+dv[n];
+                    if( nu<0 || nv<0 || nu>=width() || nv>=height() ) continue;
+                    const size_t ni = static_cast<size_t>(nv)*static_cast<size_t>(width())+static_cast<size_t>(nu);
+                    if( pImpl->PTc(ni).valid && diagnostic_labels[ni] < 0 &&
+                        std::abs(z-pImpl->PTc(ni).p3d[2]) < zgap_percentile )
+                    {
+                        diagnostic_labels[ni] = diagnostic_component;
+                        stack.push_back(ni);
+                    }
+                }
+            }
+            diagnostic_sizes.push_back(component_size);
+            if( component_size > diagnostic_retained_size )
+            {
+                diagnostic_retained_size = component_size;
+                diagnostic_retained = diagnostic_component;
+            }
+            ++diagnostic_component;
+        }
+    }
+    {
+        std::ofstream labels((workdir/"component_labels.bin").string().c_str(), std::ios::binary);
+        const char magic[8] = {'W','A','S','S','C','C','L','1'};
+        const uint32_t w = static_cast<uint32_t>(width());
+        const uint32_t h = static_cast<uint32_t>(height());
+        labels.write(magic, sizeof(magic));
+        labels.write(reinterpret_cast<const char*>(&w), sizeof(w));
+        labels.write(reinterpret_cast<const char*>(&h), sizeof(h));
+        labels.write(reinterpret_cast<const char*>(&diagnostic_labels[0]), diagnostic_labels.size()*sizeof(int32_t));
+        std::ofstream sizes((workdir/"component_sizes.csv").string().c_str());
+        sizes << "component_id,point_count\n";
+        for( size_t k=0; k<diagnostic_sizes.size(); ++k ) sizes << k << "," << diagnostic_sizes[k] << "\n";
+        std::ofstream retained((workdir/"retained_component_id.txt").string().c_str());
+        retained << diagnostic_retained << "\n";
+    }
+
+    pImpl->set_all_visited( false );

     int curr_comp_id = 0;
     int biggest_component_id = curr_comp_id;
