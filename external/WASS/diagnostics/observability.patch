+bool PovMesh::save_precluster_diagnostics( const boost::filesystem::path workdir ) const
+{
+    std::ofstream out((workdir/"precluster_depth.bin").string().c_str(), std::ios::binary);
+    if( !out.good() ) return false;
+    const char magic[8] = {'W','A','S','S','P','C','Z','1'};
+    const uint32_t w = static_cast<uint32_t>(width());
+    const uint32_t h = static_cast<uint32_t>(height());
+    out.write(magic, sizeof(magic));
+    out.write(reinterpret_cast<const char*>(&w), sizeof(w));
+    out.write(reinterpret_cast<const char*>(&h), sizeof(h));
+    for( size_t k=0; k<pImpl->size(); ++k )
+    {
+        const double z = pImpl->PTc(k).p3d[2];
+        out.write(reinterpret_cast<const char*>(&z), sizeof(z));
+    }
+    for( size_t k=0; k<pImpl->size(); ++k )
+    {
+        const uint8_t valid = pImpl->PTc(k).valid ? 1 : 0;
+        out.write(reinterpret_cast<const char*>(&valid), sizeof(valid));
+    }
+    return out.good();
+}
